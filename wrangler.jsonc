/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nikomaru-vrc",
    // Workers Cache (`cache.enabled`) を使うため、比較的新しい互換性日付が必要
    "compatibility_date": "2026-07-01",
    "compatibility_flags": ["nodejs_compat"],
    // vinext が提供するルーター選択済みの fetch ハンドラをエントリポイントにする
    "main": "vinext/server/fetch-handler",
    "assets": {
        // vinext build は静的アセットを dist/client に出力する
        "directory": "dist/client",
        "not_found_handling": "none",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    // ISR / ページキャッシュのバックエンドとして Workers Cache を利用する
    "cache": {
        "enabled": true
    },
    "vars": {
        "TABLE_URL": "https://notion-api-worker.nikomaru.workers.dev/v1/table/270a6d8e271d8095a897d4784ee5c640"
    },
    "routes": [
        {
            "pattern": "vrc.nikomaru.dev",
            "custom_domain": true
        }
    ]
    /**
     * Smart Placement
     * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
     */
    // "placement": { "mode": "smart" }
}
