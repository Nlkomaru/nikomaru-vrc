/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nikomaru-vrc",
    // Workers Cache (`cache.enabled`) を使うため、比較的新しい互換性日付が必要
    "compatibility_date": "2026-07-01",
    "compatibility_flags": ["nodejs_compat"],
    // vinext が提供するルーター選択済みの fetch ハンドラをエントリポイントにする
    "main": "vinext/server/fetch-handler",
    "assets": {
        // vinext build は静的アセットを dist/client に出力する
        "directory": "dist/client",
        "not_found_handling": "none",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    // PR ごとの `wrangler versions upload`(.github/workflows/preview.yml)が返す
    // <version>-nikomaru-vrc.<subdomain>.workers.dev を実際に配信させる
    "preview_urls": true,
    // ISR / ページキャッシュのバックエンドとして Workers Cache を利用する
    "cache": {
        "enabled": true
    },
    // TABLE_URL は Cloudflare Secrets Store(nikomaru プロジェクト)管理に移行済み。
    // 値は BSM nikomaru: nikomaru-vrc/TABLE_URL と同じもの。
    "secrets_store_secrets": [
        {
            "binding": "TABLE_URL",
            "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
            "secret_name": "nikomaru_vrc_TABLE_URL"
        }
    ],
    // Dragonfly の公開用ポートフォリオ写真を、メタデータ (D1) と実体 (R2) から読む。
    "d1_databases": [
        {
            "binding": "DRAGONFLY_DB",
            "database_name": "dragonfly",
            "database_id": "6d3b4492-c258-4ade-b97d-50d73563ed5a"
        }
    ],
    "r2_buckets": [
        {
            "binding": "DRAGONFLY_PHOTOS",
            "bucket_name": "dragonfly-photos"
        }
    ],
    "routes": [
        {
            "pattern": "vrc.nikomaru.dev",
            "custom_domain": true
        }
    ]
    /**
     * Smart Placement
     * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
     */
    // "placement": { "mode": "smart" }
}
