{
    "name": "nikomaru-vrc",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vinext dev --port 3000",
        "build": "vinext build",
        "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 3000",
        "preview": "pnpm run build && pnpm run start",
        "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
        "deploy:preview": "vinext-cloudflare deploy --config dist/server/wrangler.json --preview",
        "gen:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "check": "biome check --write ./"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-slot": "^1.2.3",
        "@react-three/drei": "^10.7.6",
        "@react-three/fiber": "^9.3.0",
        "@react-three/postprocessing": "^3.0.4",
        "@types/three": "^0.180.0",
        "@unpic/placeholder": "^0.1.2",
        "@vinext/cloudflare": "1.0.0-beta.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "graphql": "^16.11.0",
        "hono": "^4.9.8",
        "lucide-react": "^0.544.0",
        "motion": "^12.23.15",
        "next": "15.5.3",
        "next-themes": "^0.4.6",
        "notion-client": "7.5.1",
        "notion-types": "^7.5.1",
        "notion-utils": "^7.5.1",
        "postprocessing": "^6.37.8",
        "radix-ui": "^1.4.3",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-notion-x": "7.5.1",
        "react-server-dom-webpack": "^19.2.8",
        "three": "^0.180.0",
        "three-stdlib": "^2.36.0",
        "vaul": "^1.1.2",
        "vinext": "1.0.0-beta.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@cloudflare/vite-plugin": "^1.48.0",
        "@faker-js/faker": "^10.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.5.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitejs/plugin-rsc": "^0.5.32",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.13",
        "tw-animate-css": "^1.3.8",
        "typescript": "^5.9.2",
        "vite": "^8.2.0",
        "wrangler": "^4.115.0"
    },
    "packageManager": "pnpm@10.12.1",
    "engines": {
        "yarn": "please use pnpm",
        "npm": "please use pnpm",
        "node": ">=22"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "esbuild",
            "workerd"
        ]
    }
}
